APP_NAME="Cuidar no Lar"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/cuidarnolar/public
APP_KEY=gere_uma_chave_aleatoria_32_chars

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cuidar_no_lar
DB_USERNAME=root
DB_PASSWORD=

SESSION_LIFETIME=120
SESSION_SECURE=false

LOG_CHANNEL=file
LOG_LEVEL=debug
SESSION_IDLE_TIMEOUT=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Segurança / Produção
SESSION_SAMESITE=Strict
APP_ERROR_LOG=storage/logs/app-error.log
SECURITY_HSTS=true
SECURITY_CSP="default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' data: blob:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self'; upgrade-insecure-requests"
