</div><!-- /.pac-view -->


<!-- ══ Script ═══════════════════════════════════════════════════ -->
<script>
(function() {
    'use strict';

    const AGRUPADO = <?= json_encode($agrupado,   JSON_UNESCAPED_UNICODE) ?>;
    const DATAS = <?= json_encode($datas,       JSON_UNESCAPED_UNICODE) ?>;
    const TURNO_META = {
        manha: {
            label: 'Manhã',
            range: '07:00 – 13:00',
            icon: 'ti-sun'
        },
        tarde: {
            label: 'Tarde',
            range: '13:00 – 19:00',
            icon: 'ti-sun-high'
        },
        noite: {
            label: 'Noite',
            range: '19:00 – 07:00',
            icon: 'ti-moon'
        },
    };

    let dataAtual = <?= json_encode($dataAtual) ?>;
    let turnoAtual = 'tarde';

    const labelData = document.getElementById('labelData');
    const btnAnterior = document.getElementById('btnDiaAnterior');
    const btnProximo = document.getElementById('btnProximoDia');
    const turnosRow = document.getElementById('turnosRow');
    const turnoDetalhe = document.getElementById('turnoDetalhe');

    /* ── Utils ──────────────────────────────────────────────────── */
    function esc(s) {
        if (s == null) return '';
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function fmtDataBR(iso) {
        const [y, m, d] = iso.split('-');
        const DIAS = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
        const MESES = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
        const dt = new Date(iso + 'T12:00:00');
        return `${DIAS[dt.getDay()]}, ${d} ${MESES[+m-1]} ${y}`;
    }

    function iniciais(nome) {
        const p = (nome || '').trim().split(' ');
        return ((p[0] || '')[0] || '').toUpperCase() + ((p[1] || '')[0] || '').toUpperCase();
    }

    /* ── Avaliadores de sinais vitais ────────────────────────────── */
    function avalPA(v) {
        const [s, d] = (v || '').split('/').map(Number);
        if (!s || !d) return null;
        if (s >= 140 || d >= 90) return ['badge-crit', 'Elevada'];
        if (s >= 130 || d >= 85) return ['badge-warn', 'Limítrofe'];
        return ['badge-ok', 'Normal'];
    }

    function avalFC(v) {
        const n = +v;
        if (!n) return null;
        if (n > 100) return ['badge-crit', 'Taquicardia leve'];
        if (n < 60) return ['badge-crit', 'Bradicardia'];
        if (n > 90) return ['badge-warn', 'Atenção'];
        return ['badge-ok', 'Normal'];
    }

    function avalTemp(v) {
        const n = +v;
        if (!n) return null;
        if (n >= 38) return ['badge-crit', 'Febre'];
        if (n >= 37.5) return ['badge-warn', 'Febrícula'];
        return ['badge-ok', 'Afebril'];
    }

    function avalSpo2(v) {
        const n = +v;
        if (!n) return null;
        if (n < 90) return ['badge-crit', 'Crítico'];
        if (n < 95) return ['badge-warn', 'Atenção'];
        return ['badge-ok', 'Normal'];
    }

    function avalHgt(v) {
        const n = +v;
        if (!n) return null;
        if (n >= 180 || n < 70) return ['badge-crit', 'Elevado'];
        if (n >= 140) return ['badge-warn', 'Atenção'];
        return ['badge-ok', 'Normal'];
    }

    function svCol(sigla, valor, sufixo, avalFn) {
        if (!valor) return '';
        const r = avalFn ? avalFn(String(valor)) : null;
        return `<div class="sv-col">
        <div class="sv-sigla">${sigla}</div>
        <div class="sv-valor">${esc(valor)}<span class="sv-sufixo">${sufixo||''}</span></div>
        ${r ? `<span class="sv-badge ${r[0]}">${r[1]}</span>` : ''}
    </div>`;
    }

    /* ── Badge status turno ──────────────────────────────────────── */
    function badgeTurno(s) {
        const sl = (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        if (['finalizado', 'concluido'].includes(sl)) return `<span class="tc-badge tc-ok">Concluído</span>`;
        if (['intercorrencia'].includes(sl)) return `<span class="tc-badge tc-warn">Intercorrência</span>`;
        if (sl === 'rascunho') return `<span class="tc-badge tc-neutral">Rascunho</span>`;
        return `<span class="tc-badge tc-info">Em andamento</span>`;
    }

    /* ── Badge status medicação ──────────────────────────────────── */
    function badgeMed(s) {
        const sl = (s || '').toLowerCase();
        if (sl === 'administrado')
        return `<span class="med-badge med-ok"><i class="ti ti-check"></i> Administrado</span>`;
        if (sl === 'recusado') return `<span class="med-badge med-rec"><i class="ti ti-x"></i> Recusado</span>`;
        return `<span class="med-badge med-pend">Pendente</span>`;
    }

    /* ══ Render: cartões de turno ════════════════════════════════════ */
    function renderTurnos(data) {
        const dia = AGRUPADO[data] || {};
        turnosRow.innerHTML = Object.entries(TURNO_META).map(([key, meta]) => {
            const list = dia[key] || [];
            const p = list[0] || null;
            const ativo = key === turnoAtual ? ' tc--ativo' : '';
            const vazio = !p ? ' tc--vazio' : '';
            const enfNome = p?.responsavel_nome || (p ? '—' : 'Sem registro');
            return `
        <button class="turno-card${ativo}${vazio}" onclick="selTurno('${key}')">
            <div class="tc-top">
                <span class="tc-shift"><i class="ti ${meta.icon}"></i> ${meta.label}</span>
                ${p ? badgeTurno(p.status) : ''}
            </div>
            <div class="tc-enf">${esc(enfNome)}</div>
            <div class="tc-range">${meta.range}</div>
        </button>`;
        }).join('');
    }

    /* ══ Render: detalhe ════════════════════════════════════════════ */
    function renderDetalhe(data, turno) {
        const list = (AGRUPADO[data] || {})[turno] || [];

        if (!list.length) {
            turnoDetalhe.innerHTML = `
        <div class="turno-vazio">
            <i class="ti ti-clipboard-off"></i>
            Nenhum relatório registrado para o turno de ${TURNO_META[turno].label}.
        </div>`;
            return;
        }

        const p = list[0];

        /* Sinais Vitais */
        const svItens = [
            svCol('PA', p.pa, 'mmHg', avalPA),
            svCol('FC', p.fc, 'bpm', avalFC),
            svCol('Temp', p.temperatura, '°C', avalTemp),
            svCol('SpO₂', p.spo2, '%', avalSpo2),
            svCol('HGT', p.hgt, 'mg/dL', avalHgt),
        ].filter(Boolean).join('');

        const blocoSV = svItens ? `
    <div class="bloco">
        <div class="bloco-titulo"><i class="ti ti-activity"></i> Sinais vitais</div>
        <div class="sv-row">${svItens}</div>
    </div>` : '';

        /* Medicações */
        let meds = [];
        try {
            meds = p.medicacoes ? (typeof p.medicacoes === 'string' ? JSON.parse(p.medicacoes) : p.medicacoes) : [];
        } catch (e) {}

        const blocoMed = meds.length ? `
    <div class="bloco">
        <div class="bloco-titulo"><i class="ti ti-pill"></i> Medicações do turno</div>
        <table class="med-table">
            <thead><tr><th>Medicamento</th><th>Via</th><th>Horário</th><th>Status</th></tr></thead>
            <tbody>
            ${meds.map(m=>`
                <tr>
                    <td class="med-nome">${esc(m.nome||m.name||'')}</td>
                    <td class="med-via">${esc(m.via||'')}</td>
                    <td class="med-hora">${esc(m.horario||m.hora||'')}</td>
                    <td>${badgeMed(m.status)}</td>
                </tr>`).join('')}
            </tbody>
        </table>
    </div>` : '';

        /* Evolução */
        const evo = (p.evolucao || '').trim();
        const blocoEvo = evo ? `
    <div class="bloco">
        <div class="bloco-titulo"><i class="ti ti-notes"></i> Evolução de enfermagem</div>
        <div class="evolucao-txt">${esc(evo).replace(/\n/g,'<br>')}</div>
    </div>` : '';

        /* Intercorrências */
        let inters = [];
        try {
            inters = p.intercorrencias ? (typeof p.intercorrencias === 'string' ? JSON.parse(p.intercorrencias) : p
                .intercorrencias) : [];
        } catch (e) {}

        const blocoInter = inters.length ? `
    <div class="bloco">
        <div class="bloco-titulo"><i class="ti ti-alert-triangle"></i> Intercorrências</div>
        ${inters.map(i=>`
        <div class="inter-item">
            <i class="ti ti-alert-triangle inter-icon"></i>
            <div class="inter-body">
                <p>${esc(i.descricao||i.texto||'')}</p>
                ${i.hora?`<span class="inter-hora"><i class="ti ti-clock"></i> ${esc(i.hora)}</span>`:''}
            </div>
        </div>`).join('')}
    </div>` : '';

        /* Responsável */
        const resp = p.responsavel_nome || null;
        const coren = p.responsavel_coren || '';
        const assinado = /finalizado|conclu/i.test(p.status || '');

        const blocoResp = resp ? `
    <div class="bloco bloco-resp">
        <div class="bloco-titulo"><i class="ti ti-user-check"></i> Responsável pelo plantão</div>
        <div class="resp-row">
            <div class="resp-av">${iniciais(resp)}</div>
            <div class="resp-info">
                <strong>${esc(resp)}</strong>
                ${coren?`<span class="resp-coren">${esc(coren)}</span>`:''}
            </div>
            ${assinado
                ? `<span class="resp-badge resp-ok"><i class="ti ti-circle-check"></i> Relatório assinado</span>`
                : `<span class="resp-badge resp-pend"><i class="ti ti-clock"></i> Aguardando assinatura</span>`}
        </div>
    </div>` : '';

        turnoDetalhe.innerHTML = blocoSV + blocoMed + blocoEvo + blocoInter + blocoResp;
    }

    /* ══ Navegação ═══════════════════════════════════════════════════ */
    function irParaData(data) {
        dataAtual = data;
        labelData.textContent = fmtDataBR(data);

        const idx = DATAS.indexOf(data);
        btnAnterior.disabled = idx <= 0;
        btnProximo.disabled = idx >= DATAS.length - 1;

        const dia = AGRUPADO[data] || {};
        turnoAtual = ['tarde', 'manha', 'noite'].find(t => (dia[t] || []).length > 0) || 'tarde';

        renderTurnos(data);
        renderDetalhe(data, turnoAtual);
    }

    window.selTurno = function(turno) {
        turnoAtual = turno;
        renderTurnos(dataAtual);
        renderDetalhe(dataAtual, turno);
    };

    btnAnterior.addEventListener('click', () => {
        const i = DATAS.indexOf(dataAtual);
        if (i > 0) irParaData(DATAS[i - 1]);
    });
    btnProximo.addEventListener('click', () => {
        const i = DATAS.indexOf(dataAtual);
        if (i < DATAS.length - 1) irParaData(DATAS[i + 1]);
    });

    /* ── Init ────────────────────────────────────────────────────── */
    if (DATAS.length > 0) {
        irParaData(dataAtual);
    } else {
        labelData.textContent = '—';
        btnAnterior.disabled = btnProximo.disabled = true;
        turnoDetalhe.innerHTML = `
    <div class="turno-vazio">
        <i class="ti ti-clipboard-off"></i>
        Nenhum relatório registrado para este paciente.
    </div>`;
    }

})();
</script>