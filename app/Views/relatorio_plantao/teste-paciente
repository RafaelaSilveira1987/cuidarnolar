/**
 * app/Views/relatorio_plantao/paciente.php
 *
 * Variáveis esperadas do Controller:
 *   $paciente  (array)  — dados do paciente
 *   $plantoes  (array)  — todos os plantões do paciente
 *   $_user     (array)  — usuário logado
 *
 * Cada item de $plantoes pode conter:
 *   id, data_inicio, data_fim, status, pa, fc, temperatura, spo2, hgt,
 *   evolucao, nivel_consciencia, dor (int 0-10),
 *   medicacoes       (JSON ou array: [{nome, via, horario, status}]),
 *   intercorrencias  (JSON ou array: [{descricao, hora}]),
 *   responsavel_nome, responsavel_coren
 */

/* ── Determina o turno a partir da hora de início ─────────────── */
function getTurnoKey(string $datetime): string {
    $h = (int) date('H', strtotime($datetime));
    if ($h >= 7  && $h < 13) return 'manha';
    if ($h >= 13 && $h < 19) return 'tarde';
    return 'noite';
}

/* ── Agrupa: data → turno → [plantões] ──────────────────────── */
$agrupado = [];
foreach ($plantoes ?? [] as $p) {
    $dia   = date('Y-m-d', strtotime($p['data_inicio']));
    $turno = getTurnoKey($p['data_inicio']);
    $agrupado[$dia][$turno][] = $p;
}
ksort($agrupado);

$datas     = array_keys($agrupado);
$dataAtual = !empty($datas) ? end($datas) : date('Y-m-d');
?>

